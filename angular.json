{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "a848ecd7-713c-43e3-bc81-71892b019fae"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ChessDiagrams": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "output": "pdfjs",
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build"
              },
              {
                "output": "pdfjs/cmaps",
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/cmaps"
              },
              {
                "output": "pdfjs/standard_fonts",
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/standard_fonts"
              },
              {
                "output": "pdfjs/wasm",
                "glob": "**/*",
                "input": "node_modules/pdfjs-dist/wasm"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ChessDiagrams:build:production"
            },
            "development": {
              "buildTarget": "ChessDiagrams:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
